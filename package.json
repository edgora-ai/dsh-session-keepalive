{
  "name": "@local/dsh-session-keepalive",
  "version": "1.1.2",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgora-ai/dsh-session-keepalive.git"
  },
  "homepage": "https://github.com/edgora-ai/dsh-session-keepalive#readme",
  "bugs": {
    "url": "https://github.com/edgora-ai/dsh-session-keepalive/issues"
  },
  "description": "Bounded per-tab retention of recently opened DSH sessions to reduce repeated history loading.",
  "type": "module",
  "engines": {
    "dsh": "0.2.1-rc.3 || 0.2.1-rc.4"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "src/*.js",
    "build.mjs",
    "test/*.test.js"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "check": "node --check client.js && node --check index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
